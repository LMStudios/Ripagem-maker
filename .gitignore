# Por padrão, mantenha dados de trabalho e artefatos locais fora do Git.
/*
!/.gitignore
!/README.md
!/VERSION
!/app.py
!/index.html
!/LEIA-ME*.txt
!/LEIA-ME*.md
!/NOTAS-*.md
!/plataforma
/plataforma/*
!/plataforma/*.py
!/plataforma/srt_perfil_golden_brain.json
!/plataforma/static
!/electron
/electron/*
!/electron/*.cjs
!/electron/startup.html
!/electron/package*.json
!/electron/*.md
!/electron/*.icns
!/electron/*.txt
!/electron/scripts
!/electron/tests
!/electron/ci
!/distribuicao
/distribuicao/*
!/distribuicao/*.py
!/distribuicao/*.md
!/distribuicao/*.txt
!/distribuicao/*.cmd
!/distribuicao/*.command
!/distribuicao/windows
!/mac_app
!/supabase
/supabase/*
!/supabase/config.toml
!/supabase/CONFIGURAR.md
!/supabase/migrations
!/supabase/functions
!/supabase/templates
!/supabase/tests
!/tests
/tests/*
!/tests/*.py
!/tests/*.cjs

.env
.env.*
*.log
.DS_Store
__pycache__/
*.pyc
node_modules/
*.pem
*.key
*.p12
*.pfx
.supabase/
.temp/
